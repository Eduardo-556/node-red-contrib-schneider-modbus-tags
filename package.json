{
  "name": "node-red-contrib-schneider-modbus-tags",
  "version": "0.1.2",
  "description": "Read Schneider M221/M241 memory (%MW, %MF, %MD) over Modbus TCP and get real values (float, dint, int, bool, string) straight into Node-RED.",
  "main": "lib/tags.js",
  "scripts": {
    "test": "node --test test/tags.test.js test/connection.test.js test/examples.test.js",
    "test:nodes": "node --test test/nodes.test.js"
  },
  "keywords": [
    "node-red",
    "modbus",
    "schneider",
    "m221",
    "m241",
    "plc",
    "clp",
    "float",
    "string"
  ],
  "license": "MIT",
  "author": "Eduardo",
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "schneider-plc": "nodes/plc.js",
      "schneider-read": "nodes/read.js",
      "schneider-decode": "nodes/decode.js"
    }
  },
  "dependencies": {
    "modbus-serial": "^8.0.25"
  },
  "files": [
    "lib",
    "nodes",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "node-red": "^5.0.0",
    "node-red-node-test-helper": "^0.3.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eduardo-556/node-red-contrib-schneider-modbus-tags.git"
  },
  "bugs": {
    "url": "https://github.com/Eduardo-556/node-red-contrib-schneider-modbus-tags/issues"
  },
  "homepage": "https://github.com/Eduardo-556/node-red-contrib-schneider-modbus-tags#readme"
}
